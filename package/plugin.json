{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "prettier",
  "version": "3.9.9",
  "description": "Runs prettier to format source code: it takes source code files and gives back consistently formatted code. prettier comes from the open-source project prettier/prettier, which AgentMesh did not write.",
  "license": "MIT",
  "homepage": "https://github.com/prettier/prettier",
  "repository": "https://github.com/AgentMesh-Community/prettier",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "format-source-code"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "descriptor": {
        "path": "descriptor.json",
        "sha256": "67628253aef943de20f0f133116c324d7eb5642156daa718e92f644e56ff4258"
      },
      "install": {
        "path": "install.json",
        "sha256": "77538aaf014ce73842ae255681120674a80eb89f0d3886beceb3141893061a99"
      },
      "built": true,
      "draft": true,
      "from": [
        {
          "name": "prettier",
          "version": "3.9.9",
          "repository": "https://github.com/prettier/prettier",
          "commit": "ee983c58097c756f83969d6a900496fa2ad05b78",
          "license": "MIT"
        }
      ]
    }
  }
}
