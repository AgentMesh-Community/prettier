{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "prettier",
  "version": "3.9.10",
  "description": "Runs prettier to format code to enforce a consistent style: it takes code files and gives back formatted code. prettier comes from the open-source project prettier/prettier, which AgentMesh did not write.",
  "license": "MIT",
  "homepage": "https://github.com/prettier/prettier",
  "repository": "https://github.com/AgentMesh-Community/prettier",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "format-code-to-enforce-a-consistent-style"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "descriptor": {
        "path": "descriptor.json",
        "sha256": "df048d90d4f2828bb82e7eb4e3c94e07f39a64117929ef32b0abd9bb7d518129"
      },
      "install": {
        "path": "install.json",
        "sha256": "b968bee3d4e16b603ebb5ec42c81604ebd2c4813e4d49d6e3806e2ba946c3649"
      },
      "built": true,
      "draft": true,
      "from": [
        {
          "name": "prettier",
          "version": "3.9.9",
          "repository": "https://github.com/prettier/prettier",
          "commit": "ee983c58097c756f83969d6a900496fa2ad05b78",
          "license": "MIT"
        }
      ]
    }
  }
}
